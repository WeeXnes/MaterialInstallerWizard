<UserControl x:Class="WpfApplication2.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfApplication2"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Loaded="DownloadPage_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="10" Background="#18191f" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="2"
                        Name="btn_Continue"
                        Style="{StaticResource UniversalMaterialButton}"
                        Content="Continue"
                        Foreground="Gray"
                        Width="100px"
                        Background="#1e1f26"
                        Height="40px"
                        Click="ContinueButton_OnClick"
                        HorizontalAlignment="Right"
                        Margin="0,0,5,5"
                        VerticalAlignment="Bottom"/>
                <Button Grid.Row="2"
                        Name="btn_Back"
                        Style="{StaticResource UniversalMaterialButton}"
                        Content="Back"
                        Foreground="Gray"
                        Width="100px"
                        Background="#1e1f26"
                        Height="40px"
                        HorizontalAlignment="Left"
                        Margin="5,0,0,5"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" CornerRadius="10" Background="#18191f" Margin="5,0,5,5">
            <Border Margin="7" Background="#1e1f26" CornerRadius="10" Name="CustomProgressBar_Parent">
                <Border Background="#3c3e4d" CornerRadius="10" HorizontalAlignment="Left"
                        Name="CustomProgressBar"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
